# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Storage ───────────────────────────────────────────────────────────────────
# Downloads are restricted to these roots; requests for anything outside them
# are rejected. Add more roots with EXTRA_SAVE_DIRS="/mnt/nas:/media/usb".
DEFAULT_SAVE_DIR=/data/downloads
APP_CACHE_DIR=/data/cache
APP_TEMP_DIR=/data/tmp
# EXTRA_SAVE_DIRS=

# ── Binaries ──────────────────────────────────────────────────────────────────
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# ── Security ──────────────────────────────────────────────────────────────────
# Leave APP_TOKEN empty to keep the app open (only sensible on loopback).
# Set it to require a sign-in before anything is served.
# APP_TOKEN=
# SESSION_COOKIE_SECURE=true

# ── Queue ─────────────────────────────────────────────────────────────────────
MAX_TASK_HISTORY=200

# ── Clipping ──────────────────────────────────────────────────────────────────
# precise = re-encode so the cut lands on the exact timestamp
# fast    = stream copy, snaps back to the nearest keyframe
CLIP_CUT_MODE=precise

# ── AI transcript pipeline ────────────────────────────────────────────────────
HF_HOME=/data/cache/huggingface
HF_HUB_CACHE=/data/cache/huggingface/hub
TRANSFORMERS_CACHE=/data/cache/huggingface/transformers

# Set to true on hosts that cannot fit bart-large in RAM (e.g. 512MB free tiers)
# to call the Hugging Face serverless API instead of running models locally.
USE_HF_INFERENCE_API=false
# HF_TOKEN=

AI_CHUNK_SECONDS=60
AI_IMPORTANCE_THRESHOLD=0.4
AI_MAX_SECTIONS=8
AI_MIN_SECTION_SECONDS=15
AI_MAX_SECTION_SECONDS=240
AI_CACHE_TTL_SECONDS=604800
# 0 keeps the models loaded forever; otherwise they are freed after this idle time.
AI_IDLE_UNLOAD_SECONDS=900
# AI_NLI_MODEL=facebook/bart-large-mnli
# AI_SUMMARY_MODEL=facebook/bart-large-cnn

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
