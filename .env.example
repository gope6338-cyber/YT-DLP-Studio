HOST=0.0.0.0
PORT=8000
DEFAULT_SAVE_DIR=/data/downloads
APP_CACHE_DIR=/data/cache
APP_TEMP_DIR=/data/tmp
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
HF_HOME=/data/cache/huggingface
HF_HUB_CACHE=/data/cache/huggingface/hub
TRANSFORMERS_CACHE=/data/cache/huggingface/transformers
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=0

# AI: run models locally (self-host default, needs requirements-full.txt) or
# via the Hugging Face Inference API (the only option on Vercel).
USE_HF_INFERENCE_API=false
HF_TOKEN=

# Serverless (Vercel) guard rails
#MAX_VIDEO_HEIGHT=1080
#MAX_MERGE_BYTES=419430400
#MAX_CLIP_SECONDS=600
#MAX_CLIP_BYTES=419430400
