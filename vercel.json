{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "static",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/_shared/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
